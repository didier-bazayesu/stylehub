// StyleHub — Full Database Schema
// PostgreSQL on Neon (serverless)

generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────

enum Role {
  GUEST
  CUSTOMER
  VENDOR
  ADMIN
  SUPER_ADMIN
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

// Tracks WHY a product was archived so the system can restore
// only its own archives when a vendor is re-enabled.
enum ArchiveReason {
  VENDOR_DISABLED  // set by admin when vendor account is suspended
  MANUAL           // set by vendor themselves
  OUT_OF_STOCK     // set automatically when stock hits 0
  POLICY           // set by admin for policy violation
}

enum NotificationType {
  ORDER_UPDATE
  REVIEW
  NEW_PRODUCT
  PROMOTION
  SYSTEM
}

// ─── User ─────────────────────────────────────────────────────────
// Soft-deleted (deleted_at) to preserve order & review history.

model User {
  id                       String    @id @default(cuid())
  email                    String    @unique
  password_hash            String
  first_name               String
  last_name                String
  avatar_url               String?
  phone                    String?
  role                     Role      @default(CUSTOMER)
  is_verified              Boolean   @default(false)
  is_active                Boolean   @default(true)
  refresh_token            String?
  email_verification_token String?
  password_reset_token     String?
  password_reset_expires   DateTime?
  created_at               DateTime  @default(now())
  updated_at               DateTime  @updatedAt
  deleted_at               DateTime?

  // Cascade: personal data owned by user
  vendor        Vendor?        @relation("UserVendor")
  addresses     Address[]
  cart          Cart?
  wishlist      Wishlist?
  notifications Notification[]

  // Restrict: financial records — cannot delete user while orders exist
  orders Order[]

  // SetNull: keep reviews, anonymize the author
  reviews Review[]

  @@index([email])
}

// ─── Vendor ───────────────────────────────────────────────────────
// Soft-deleted to preserve order/analytics history.

model Vendor {
  id               String       @id @default(cuid())
  user_id          String       @unique
  // Cascade: vendor is fully owned by user — user deleted → vendor deleted
  user             User         @relation("UserVendor", fields: [user_id], references: [id], onDelete: Cascade)
  status           VendorStatus @default(PENDING)
  business_name    String
  business_email   String
  description      String?
  rejection_reason String?
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt
  deleted_at       DateTime?

  // Cascade: store is owned by vendor
  store     Store?

  // Restrict: products are business records — handle archiving in service layer
  products  Product[]

  // Restrict: financial records
  orders    OrderItem[]

  // Cascade: analytics are derived data, safe to remove with vendor
  analytics Analytics[]
}

// ─── Store ────────────────────────────────────────────────────────

model Store {
  id          String   @id @default(cuid())
  vendor_id   String   @unique
  // Cascade: store is owned by vendor — vendor deleted → store deleted
  vendor      Vendor   @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  name        String
  slug        String   @unique
  logo_url    String?
  banner_url  String?
  description String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([slug])
}

// ─── Category ─────────────────────────────────────────────────────
// Restrict on both self-relation and product relation:
// Admin must reassign products before deleting a category.

model Category {
  id        String     @id @default(cuid())
  name      String     @unique
  slug      String     @unique
  image_url String?
  parent_id String?
  // Restrict: cannot delete parent while subcategories exist
  parent    Category?  @relation("CategoryTree", fields: [parent_id], references: [id], onDelete: Restrict)
  children  Category[] @relation("CategoryTree")
  // Restrict: cannot delete category while products use it
  products  Product[]

  @@index([slug])
}

// ─── Product ──────────────────────────────────────────────────────
// Soft-deleted (deleted_at) to preserve order history.
// archive_reason tracks WHY it was archived so restores are surgical.

model Product {
  id             String         @id @default(cuid())
  vendor_id      String
  // Restrict: products survive vendor soft-delete; service handles archiving
  vendor         Vendor         @relation(fields: [vendor_id], references: [id], onDelete: Restrict)
  category_id    String
  // Restrict: admin must move products before deleting a category
  category       Category       @relation(fields: [category_id], references: [id], onDelete: Restrict)
  name           String
  slug           String         @unique
  description    String
  base_price     Decimal        @db.Decimal(10, 2)
  status         ProductStatus  @default(DRAFT)
  archive_reason ArchiveReason?
  is_featured    Boolean        @default(false)
  total_stock    Int            @default(0)
  avg_rating     Float          @default(0)
  review_count   Int            @default(0)
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt
  deleted_at     DateTime?

  // Cascade: images & variants have no standalone value
  variants ProductVariant[]
  images   ProductImage[]

  // Cascade: remove from active carts & wishlists when product is deleted
  cart_items     CartItem[]
  wishlist_items WishlistItem[]

  // Cascade: reviews belong to product
  reviews Review[]

  // SetNull: keep order line items even after product is removed
  order_items OrderItem[]

  @@index([vendor_id, status])
  @@index([category_id])
  @@index([slug])
}

// ─── ProductVariant ───────────────────────────────────────────────

model ProductVariant {
  id         String  @id @default(cuid())
  product_id String
  // Cascade: variants are owned by product
  product    Product @relation(fields: [product_id], references: [id], onDelete: Cascade)
  sku        String  @unique
  size       String?
  color      String?
  price      Decimal @db.Decimal(10, 2)
  stock      Int     @default(0)

  // Cascade: remove variant from active carts
  cart_items CartItem[]

  // SetNull: keep order line items even after variant is removed
  order_items OrderItem[]
}

// ─── ProductImage ─────────────────────────────────────────────────

model ProductImage {
  id            String  @id @default(cuid())
  product_id    String
  // Cascade: images are owned by product
  product       Product @relation(fields: [product_id], references: [id], onDelete: Cascade)
  url           String
  public_id     String
  is_primary    Boolean @default(false)
  display_order Int     @default(0)
}

// ─── Cart ─────────────────────────────────────────────────────────

model Cart {
  id         String     @id @default(cuid())
  user_id    String     @unique
  // Cascade: cart is personal session data
  user       User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt
  items      CartItem[]
}

model CartItem {
  id         String         @id @default(cuid())
  cart_id    String
  // Cascade: items belong to the cart
  cart       Cart           @relation(fields: [cart_id], references: [id], onDelete: Cascade)
  product_id String
  // Cascade: product removed → remove from cart
  product    Product        @relation(fields: [product_id], references: [id], onDelete: Cascade)
  variant_id String
  // Cascade: variant removed → remove from cart
  variant    ProductVariant @relation(fields: [variant_id], references: [id], onDelete: Cascade)
  quantity   Int
  added_at   DateTime       @default(now())

  @@unique([cart_id, variant_id])
}

// ─── Wishlist ─────────────────────────────────────────────────────

model Wishlist {
  id      String         @id @default(cuid())
  user_id String         @unique
  // Cascade: wishlist is personal data
  user    User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  items   WishlistItem[]
}

model WishlistItem {
  id          String   @id @default(cuid())
  wishlist_id String
  // Cascade: items belong to the wishlist
  wishlist    Wishlist @relation(fields: [wishlist_id], references: [id], onDelete: Cascade)
  product_id  String
  // Cascade: product removed → remove from wishlist
  product     Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  added_at    DateTime @default(now())

  @@unique([wishlist_id, product_id])
}

// ─── Order ────────────────────────────────────────────────────────

model Order {
  id                       String      @id @default(cuid())
  user_id                  String
  // Restrict: cannot delete user while orders exist (financial record)
  user                     User        @relation(fields: [user_id], references: [id], onDelete: Restrict)
  address_id               String
  // Restrict: cannot delete address that is referenced by orders
  address                  Address     @relation(fields: [address_id], references: [id], onDelete: Restrict)
  status                   OrderStatus @default(PENDING)
  subtotal                 Decimal     @db.Decimal(10, 2)
  shipping_cost            Decimal     @db.Decimal(10, 2)
  discount                 Decimal     @default(0) @db.Decimal(10, 2)
  total                    Decimal     @db.Decimal(10, 2)
  stripe_payment_intent_id String?
  coupon_code              String?
  notes                    String?
  created_at               DateTime    @default(now())
  updated_at               DateTime    @updatedAt

  // Cascade: line items belong to the order
  items   OrderItem[]
  // Cascade: payment record belongs to the order
  payment Payment?

  @@index([user_id, status])
}

model OrderItem {
  id         String  @id @default(cuid())
  order_id   String
  // Cascade: line items belong to the order
  order      Order   @relation(fields: [order_id], references: [id], onDelete: Cascade)

  // SetNull: keep line item even if product is later soft-deleted
  product_id String?
  product    Product? @relation(fields: [product_id], references: [id], onDelete: SetNull)

  // SetNull: keep line item even if variant is later deleted
  variant_id String?
  variant    ProductVariant? @relation(fields: [variant_id], references: [id], onDelete: SetNull)

  vendor_id   String
  // Restrict: financial record — cannot delete vendor with existing orders
  vendor      Vendor  @relation(fields: [vendor_id], references: [id], onDelete: Restrict)

  // Snapshot fields: preserve product details at time of purchase
  product_name  String  @default("")
  variant_sku   String  @default("")
  quantity      Int
  unit_price    Decimal @db.Decimal(10, 2)
  total_price   Decimal @db.Decimal(10, 2)
  status        OrderStatus @default(PENDING)
}

// ─── Payment ──────────────────────────────────────────────────────

model Payment {
  id                    String        @id @default(cuid())
  order_id              String        @unique
  // Cascade: payment belongs to the order
  order                 Order         @relation(fields: [order_id], references: [id], onDelete: Cascade)
  stripe_payment_intent String
  amount                Decimal       @db.Decimal(10, 2)
  currency              String        @default("usd")
  status                PaymentStatus @default(PENDING)
  paid_at               DateTime?
  created_at            DateTime      @default(now())
}

// ─── Address ──────────────────────────────────────────────────────

model Address {
  id          String  @id @default(cuid())
  user_id     String
  // Cascade: addresses are personal data owned by user
  user        User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  full_name   String
  phone       String
  line1       String
  line2       String?
  city        String
  state       String
  postal_code String
  country     String
  is_default  Boolean @default(false)

  // Restrict: cannot delete an address that orders reference
  orders Order[]
}

// ─── Review ───────────────────────────────────────────────────────
// user_id is nullable so reviews survive user soft-deletion (anonymized).

model Review {
  id                   String   @id @default(cuid())
  // SetNull: keep review text, anonymize the author when user is deleted
  user_id              String?
  user                 User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)
  product_id           String
  // Cascade: reviews belong to the product
  product              Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  rating               Int
  comment              String?
  is_verified_purchase Boolean  @default(false)
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt
  deleted_at           DateTime?

  @@unique([user_id, product_id])
}

// ─── Coupon ───────────────────────────────────────────────────────

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  discount_type  String
  discount_value Decimal   @db.Decimal(10, 2)
  min_order      Decimal?  @db.Decimal(10, 2)
  max_uses       Int?
  uses_count     Int       @default(0)
  expires_at     DateTime?
  is_active      Boolean   @default(true)
  created_at     DateTime  @default(now())
}

// ─── Notification ─────────────────────────────────────────────────

model Notification {
  id         String           @id @default(cuid())
  user_id    String
  // Cascade: notifications are personal data
  user       User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  type       NotificationType
  title      String
  message    String
  is_read    Boolean          @default(false)
  data       Json?
  created_at DateTime         @default(now())

  @@index([user_id, is_read])
}

// ─── Analytics ────────────────────────────────────────────────────

model Analytics {
  id         String   @id @default(cuid())
  vendor_id  String
  // Cascade: analytics are derived data owned by vendor
  vendor     Vendor   @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  revenue    Decimal  @db.Decimal(10, 2)
  orders     Int      @default(0)
  units_sold Int      @default(0)

  @@unique([vendor_id, date])
}

// ─── AuditLog ─────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  user_id    String?
  action     String
  entity     String
  entity_id  String?
  old_value  Json?
  new_value  Json?
  ip_address String?
  created_at DateTime @default(now())
}
